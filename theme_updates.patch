+  font-size: 14px !important;
+  color-scheme: dark;
+  transition: all 0.2s ease;
+}
+
+.tipster-input::placeholder {
+  color: #64748b !important;
+}
+
+.tipster-input:focus,
+.tipster-select:focus {
+  border-color: #22c55e !important;
+  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2) !important;
+  background-color: #0d1522 !important;
+  color: #ffffff !important;
+  outline: none !important;
+}
+
+.tipster-select {
+  appearance: none !important;
+  -webkit-appearance: none !important;
+  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%2322c55e' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
+  background-repeat: no-repeat !important;
+  background-position: right 14px center !important;
+  background-size: 14px 10px !important;
+  padding-right: 36px !important;
+  cursor: pointer;
+}
+
+/* Dark Autofill Fix */
+input:-webkit-autofill,
+input:-webkit-autofill:hover, 
+input:-webkit-autofill:focus,
+input:-webkit-autofill:active,
+textarea:-webkit-autofill,
+select:-webkit-autofill {
+  -webkit-box-shadow: 0 0 0 1000px #090e17 inset !important;
+  -webkit-text-fill-color: #f8fafc !important;
+  transition: background-color 5000s ease-in-out 0s;
+  caret-color: #ffffff !important;
+}
+
+/* Tipster Module Mobile & Responsive Enhancements */
+@media (max-width: 768px) {
+  .tipster-btn-primary,
+  .tipster-btn-outline {
+    padding: 8px 16px;
+    font-size: 12.5px;
+  }
+
+  .font-space-grotesk.display-4,
+  .font-space-grotesk.display-5 {
+    font-size: 1.85rem !important;
+  }
+
+  .tipster-tip-card {
+    padding: 1rem !important;
+  }
+}
+
+@media (max-width: 576px) {
+  .tipster-btn-primary:not(.btn-sm):not(.flex-fill),
+  .tipster-btn-outline:not(.btn-sm):not(.flex-fill) {
+    width: 100%;
+    justify-content: center;
+  }
+
+  .tipster-mobile-stack {
+    flex-direction: column !important;
+    align-items: stretch !important;
+  }
+
+  .tipster-mobile-full {
+    width: 100% !important;
+  }
+}
+
+/* ==========================================================================
+   SportsVerge Visual Identity Refinement (Client Feedback)
+   • Main Canvas: #FFFDF9 (Premium Cream Base)
+   • Typography & Structural Elements: #1C1F22 (Crisp Charcoal)
+   • Interactive Anchors & CTAs: #FFCC00 (Gold)
+   • Real-Time Data Shifts & Highlights: #4A90E2 (Sky Blue)
+   ========================================================================== */
+
+:root {
+  --bs-light-rgb: 28, 31, 34;
+  --bs-body-bg: #FFFDF9;
+  --bs-body-color: #1C1F22;
+}
+
+body, main {
+  background-color: #FFFDF9 !important;
+  color: #1C1F22 !important;
+}
+
+/* Typography Headings */
+h1, h2, h3, h4, h5, h6 {
+  color: #1C1F22;
+  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
+}
+
+/* Explicit text overrides for hero overlays, banners, and dark media elements */
+.carousel-caption h1,
+.carousel-caption h2,
+.carousel-caption h3,
+.carousel-caption h4,
+.carousel-caption h5,
+.carousel-caption h6,
+.custom-caption h1,
+.custom-caption h2,
+.custom-caption h3,
+.custom-caption h4,
+.custom-caption h5,
+.custom-caption h6,
+.featured-news-section h2,
+.featured-overlay ~ * h2,
+.featured-news-card h2,
+.dark-overlay-content h1,
+.dark-overlay-content h2,
+.dark-overlay-content p,
+.text-white-force {
+  color: #FFFFFF !important;
+}
+
+.carousel-caption p,
+.custom-caption p,
+.featured-news-section p {
+  color: rgba(255, 255, 255, 0.9) !important;
+}
+
+/* Structural Card Containers */
+.bg-card,
+.fixtures-section,
+.results-section,
+.popular-players,
+.news-section,
+.live-scores-section,
+.popular-teams-section,
+.standings-section,
+.score-box,
+.fixture-card,
+.player-card,
+.news-card,
+.horizontal-ad-section {
+  background-color: #FFFFFF !important;
+  border-color: #EAE5DC !important;
+  color: #1C1F22;
+  box-shadow: 0 4px 18px rgba(28, 31, 34, 0.04);
+}
+
+.score-box:hover,
+.fixture-card:hover,
+.news-card:hover,
+.player-card:hover {
+  border-color: #4A90E2 !important;
+  box-shadow: 0 8px 24px rgba(74, 144, 226, 0.12) !important;
+  transform: translateY(-2px);
+  transition: all 0.2s ease-in-out;
+}
+
+/* Charcoal typography enforcement inside card components */
+.bg-card .text-light,
+.bg-card .text-white:not(.badge):not(.btn):not(.preserve-white),
+.score-box .text-light,
+.score-box .text-white:not(.badge):not(.btn),
+.fixture-card .text-light,
+.fixture-card .text-white:not(.badge):not(.btn),
+.player-card .text-light,
+.player-card .text-white:not(.badge):not(.btn),
+.popular-teams-section .text-light,
+.standings-section .text-light,
+.news-card .text-white:not(.badge):not(.btn) {
+  color: #1C1F22 !important;
+}
+
+/* Subtitles and secondary info */
+.text-muted {
+  color: #5C646D !important;
+}
+
+/* Structural Dividers */
+.border-dark {
+  border-color: #EAE5DC !important;
+}
+
+/* Section indicator line in client Gold */
+.border-success,
+.border-start.border-success {
+  border-color: #FFCC00 !important;
+}
+
+/* Gold Interactive CTAs & Tabs */
+.btn-success,
+.btn-signup,
+.nav-pills .nav-link.active,
+.custom-tabs .nav-link.active {
+  background-color: #FFCC00 !important;
+  border-color: #FFCC00 !important;
+  color: #1C1F22 !important;
+  font-weight: 700 !important;
+}
+
+.btn-success:hover,
+.btn-signup:hover {
+  background-color: #E6B800 !important;
+  border-color: #E6B800 !important;
+  color: #1C1F22 !important;
+}
+
+.btn-outline-success {
+  color: #1C1F22 !important;
+  border-color: #1C1F22 !important;
+  background-color: transparent !important;
+  font-weight: 600 !important;
+}
+
+.btn-outline-success:hover {
+  background-color: #FFCC00 !important;
+  border-color: #FFCC00 !important;
+  color: #1C1F22 !important;
+}
+
+/* Real-Time Data Shifts & Strategic Highlights (Sky Blue #4A90E2) */
+.badge.bg-danger,
+.badge-live {
+  background-color: #4A90E2 !important;
+  color: #FFFFFF !important;
+  font-weight: 700 !important;
+  box-shadow: 0 2px 8px rgba(74, 144, 226, 0.35);
+}
+
+a.text-success,
+.text-success {
+  color: #4A90E2 !important;
+}
+
+a.text-success:hover,
+.text-success:hover {
+  color: #357ABD !important;
+}
+
+/* Tables */
+.table-dark {
+  --bs-table-bg: transparent !important;
+  --bs-table-color: #1C1F22 !important;
+  --bs-table-border-color: #EAE5DC !important;
+}
+
+.table-dark thead th {
+  color: #5C646D !important;
+  font-size: 11px;
+  font-weight: 700;
+  border-bottom: 2px solid #EAE5DC !important;
+}
+
+.table-dark tbody td {
+  border-bottom: 1px solid #EAE5DC !important;
+  color: #1C1F22 !important;
+}
